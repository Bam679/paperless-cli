      "op": "read",
      "summary": "list items"
    },
    {
      "args": [],
      "flags": [
        {
          "name": "example",
          "type": "bool",
          "usage": "print an example policy file"
        },
        {
          "name": "claude-settings",
          "type": "bool",
          "usage": "print recommended Claude Code permission rules"
        }
      ],
      "kind": "read",
      "name": "policy",
      "op": "read",
