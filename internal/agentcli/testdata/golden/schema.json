      "op": "read",
      "summary": "show help"
    },
    {
      "args": [],
      "default_fields": [
        "id",
        "title",
        "list"
      ],
      "fields": [
        "id",
        "title",
        "list",
        "done"
      ],
      "flags": [
        {
          "name": "list",
          "type": "string",
          "usage": "filter by list"
        }
      ],
